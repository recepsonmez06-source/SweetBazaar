# Metin dosyalarında satır sonlarını Git yönetsin
* text=auto

# Betikler: platforma göre sabit satır sonu
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# --- Git LFS: büyük ikili dosyalar ---
# Görseller
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
