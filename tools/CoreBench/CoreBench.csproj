<Project Sdk="Microsoft.NET.Sdk">

  <!-- Measures the engine-independent game logic (Game/Assets/_Game/Scripts/Core) without starting Unity.
       Usage: run "dotnet run" in Release configuration on this project, with the arguments: scramble, curve [from to] or level N.
       The Core sources are compiled straight from the Unity project (not copied), with C# 9 like Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CoreBench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Game\Assets\_Game\Scripts\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
